# Plausible (cookieless, GDPR-friendly). Leave empty to disable analytics entirely.
VITE_PLAUSIBLE_DOMAIN=kournosenkov.com
# Optional: self-hosted Plausible / proxy script URL.
# If this points anywhere other than https://plausible.io, update the CSP (script-src/connect-src) in vercel.json
# and SCRIPT_ORIGINS in src/util.ts.
VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.js

# Contact form (Vercel Function api/contact.ts → Resend). Server-side only, never prefix with VITE_.
RESEND_API_KEY=
CONTACT_TO=ser.corum@gmail.com
# Must be an address on a domain verified in Resend
CONTACT_FROM=kournosenkov.com <contact@kournosenkov.com>

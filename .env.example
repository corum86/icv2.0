# Vercel Web Analytics (cookieless, first-party). "true" loads the script; empty/unset = no analytics at all.
# Also enable Web Analytics for the project in the Vercel dashboard. Read at build time: redeploy after changing.
VITE_VERCEL_ANALYTICS=true

# Contact form (Vercel Function api/contact.ts → Resend). Server-side only, never prefix with VITE_.
RESEND_API_KEY=
CONTACT_TO=ser.corum@gmail.com
# Must be an address on a domain verified in Resend
CONTACT_FROM=kournosenkov.com <contact@kournosenkov.com>
